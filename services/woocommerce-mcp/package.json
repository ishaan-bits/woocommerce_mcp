{
  "name": "@mcp/woocommerce-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "WooCommerce MCP server built by us. Exposes list_products, create_product, list_orders, get_order and update_order_status over Streamable HTTP by calling the WooCommerce REST API.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "start": "node dist/index.js",
    "dev": "node --watch src/index.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5"
  }
}
