{
  "name": "@mcp/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "MCP gateway: an MCP server downstream at /mcp and an MCP client upstream, with a qualified-name tool registry, pre-forward schema validation, per-upstream timeouts and failure isolation.",
  "type": "module",
  "scripts": {
    "build": "npm run build -w @mcp/shared && tsc -p tsconfig.build.json",
    "typecheck": "npm run build -w @mcp/shared && tsc -p tsconfig.json",
    "test": "npm run build -w @mcp/shared && node --test \"test/**/*.test.ts\"",
    "start": "node dist/index.js",
    "dev": "node --watch src/index.ts",
    "migrate": "npm run build -w @mcp/shared && node src/db/migrate.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mcp/shared": "*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1"
  }
}
