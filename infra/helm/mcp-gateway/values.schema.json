{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "mcp-gateway chart values",
  "type": "object",
  "properties": {
    "logLevel": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error"]
    },
    "gateway": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "service": { "$ref": "#/definitions/httpService" },
        "toolCacheTtlMs": { "type": "integer", "minimum": 1000 },
        "upstreamAllowedPrivateHosts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "upstreamMaxResponseBytes": { "type": "integer", "minimum": 0 },
        "upstreamMaxConcurrentCalls": { "type": "integer", "minimum": 1, "maximum": 100 },
        "rateLimitPerMinute": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "rateLimitBurst": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "jsonBodyLimit": { "type": "string", "pattern": "^[0-9]+(b|kb|mb|gb)?$", "maxLength": 8 },
        "loginMaxFailuresPerIp": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "loginFailureWindowMs": { "type": "integer", "minimum": 1000 },
        "trustProxy": { "type": "integer", "minimum": 0, "maximum": 10 },
        "llm": {
          "type": "object",
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "baseUrl": { "type": "string" },
            "requestTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 }
          },
          "required": ["model", "baseUrl", "requestTimeoutMs"]
        },
        "migrate": {
          "type": "object",
          "properties": {
            "maxAttempts": { "type": "integer", "minimum": 1 },
            "sleepSeconds": { "type": "integer", "minimum": 1 }
          }
        },
        "publicUrl": {
          "type": "string",
          "pattern": "^$|^https?:\\/\\/[A-Za-z0-9.\\-[\\]:_]+$"
        },
        "resources": { "$ref": "#/definitions/resources" }
      },
      "required": ["replicas", "image", "service"]
    },
    "woocommerceMcp": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "storeMode": { "type": "string", "enum": ["mock", "real"] },
        "storeUrl": { "type": "string" },
        "resources": { "$ref": "#/definitions/resources" }
      },
      "required": ["replicas", "image", "port", "storeMode"]
    },
    "inventoryMcp": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "resources": { "$ref": "#/definitions/resources" }
      },
      "required": ["replicas", "image", "port"]
    },
    "supportMcp": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "resources": { "$ref": "#/definitions/resources" }
      },
      "required": ["replicas", "image", "port"]
    },
    "dashboard": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "service": { "$ref": "#/definitions/httpService" },
        "gatewayUpstream": { "type": "string" },
        "resources": { "$ref": "#/definitions/resources" }
      },
      "required": ["replicas", "image", "service"]
    },
    "postgres": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 1, "maximum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "user": { "type": "string", "minLength": 1 },
        "database": { "type": "string", "minLength": 1 },
        "persistence": {
          "type": "object",
          "properties": {
            "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" },
            "storageClass": { "type": "string" }
          },
          "required": ["size"]
        },
        "resources": { "$ref": "#/definitions/resources" }
      },
      "required": ["image", "user", "database", "persistence"]
    },
    "mockStore": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "resources": { "$ref": "#/definitions/resources" }
      },
      "required": ["enabled", "image", "port"]
    },
    "wordpress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "cliImage": { "$ref": "#/definitions/image" },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 1 },
        "siteUrl": {
          "type": "string",
          "pattern": "^https?:\\/\\/[^/?#]+$"
        },
        "siteTitle": { "type": "string", "minLength": 1 },
        "adminUser": { "type": "string", "minLength": 1 },
        "adminEmail": { "type": "string", "minLength": 3 },
        "coreVersion": { "type": "string", "minLength": 1 },
        "woocommerceVersion": { "type": "string", "minLength": 1 },
        "persistence": {
          "type": "object",
          "properties": {
            "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" },
            "storageClass": { "type": "string" }
          },
          "required": ["size"]
        },
        "resources": { "$ref": "#/definitions/resources" }
      },
      "required": ["enabled", "image", "cliImage", "siteUrl", "adminUser", "adminEmail", "coreVersion", "woocommerceVersion", "persistence"]
    },
    "wordpressDb": {
      "type": "object",
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "database": { "type": "string", "minLength": 1 },
        "user": { "type": "string", "minLength": 1 },
        "persistence": {
          "type": "object",
          "properties": {
            "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" },
            "storageClass": { "type": "string" }
          },
          "required": ["size"]
        },
        "resources": { "$ref": "#/definitions/resources" }
      },
      "required": ["image", "database", "user", "persistence"]
    },
    "secrets": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "data": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["create", "existingSecret", "data"]
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "annotations": { "type": "object" },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          },
          "required": ["enabled", "secretName"]
        }
      },
      "required": ["enabled", "className", "host", "tls"]
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "required": ["enabled"]
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": {
          "type": "string",
          "minLength": 1,
          "allOf": [{ "not": { "enum": ["latest"] } }]
        },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository", "tag", "pullPolicy"]
    },
    "httpService": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodePort": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 30000, "maximum": 32767 }
          ]
        }
      },
      "required": ["type", "port"]
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        }
      }
    }
  }
}
