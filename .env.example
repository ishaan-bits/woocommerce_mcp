# ---------------------------------------------------------------------------
# Copy to `.env` and fill in values. `.env` is git-ignored.
# Milestone 0–2 placeholders still work for the WooCommerce MCP server and for gateway
# unit tests; the gateway process itself now REQUIRES API_KEY_PEPPER and DATABASE_URL
# (Milestone 3), and `npm run migrate` applies the schema before first start.
# Real secrets are never committed; in Kubernetes they live in Secrets.
# ---------------------------------------------------------------------------

# --- Gateway ---------------------------------------------------------------
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
# Base URL the gateway uses to reach the WooCommerce MCP server (ClusterIP in k8s)
WOOCOMMERCE_MCP_URL=http://localhost:8081/mcp
# Optional extra upstreams: setting the URL enables that upstream. At least one of the
# three *_MCP_URL variables must be set; an unset URL keeps its upstream out of tools/list.
# INVENTORY_MCP_URL=http://localhost:8083/mcp
# SUPPORT_MCP_URL=http://localhost:8084/mcp
# Per-upstream defaults (milliseconds)
UPSTREAM_TIMEOUT_MS=10000
UPSTREAM_CONNECT_TIMEOUT_MS=3000
# How long a discovered upstream tool list stays fresh (default 60000)
# TOOL_CACHE_TTL_MS=60000
# Shared JSON-log level for the gateway and the MCP servers: debug|info|warn|error
# LOG_LEVEL=info

# --- Application database (PostgreSQL) -------------------------------------
# Runtime connection used by the gateway for users, key hashes and the audit log.
# Required (postgres:// or postgresql://); the gateway refuses to start without it.
DATABASE_URL=postgresql://mcp:mcp_local_password@localhost:5432/mcp_gateway
# Admin connection for `npm run migrate` only (needs CREATE TABLE/ROLE privileges).
# Defaults to DATABASE_URL when unset — keep them different in any shared database.
# MIGRATE_DATABASE_URL=postgresql://mcp_admin:admin_password@localhost:5432/mcp_gateway
# Least-privilege runtime role (append-only audit) created by the migration runner
# when this is set; omit for dev-only single-user mode.
# MCP_APP_DB_PASSWORD=change-me-app-role-password
# Test-only: disposable PostgreSQL database for test/integration/postgres.test.ts.
# When unset that suite skips WITH A PRINTED REASON (never silently).
# TEST_DATABASE_URL=postgresql://mcp:pw@127.0.0.1:5433/mcp_gateway_test
POSTGRES_USER=mcp
POSTGRES_PASSWORD=mcp_local_password
POSTGRES_DB=mcp_gateway

# --- WooCommerce REST API (used only by services/woocommerce-mcp) ----------
# Create these in WooCommerce: Settings > Advanced > REST API (read/write).
# Consumer secret is shown only once - never commit the real value.
# WooCommerce only accepts Basic auth (consumer key/secret) when the store is
# served over HTTPS; plain-HTTP stores would need OAuth 1.0a (not implemented).
WOOCOMMERCE_STORE_URL=https://your-store.example
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret
# Optional MCP server settings (defaults shown)
# HOST=127.0.0.1
# PORT=8081
# WOOCOMMERCE_TIMEOUT_MS=10000
# LOG_LEVEL=info
# Comma-separated Host-header allowlist when binding to non-localhost
# MCP_ALLOWED_HOSTS=

# --- Auth ------------------------------------------------------------------
# Pepper added to API-key hashes before storing (keep out of git).
# REQUIRED by the gateway: at least 16 characters; never reuse the database password.
# Store it as its own Secret, separate from DATABASE_URL (threat-model A3).
API_KEY_PEPPER=change-me-to-a-long-random-string

# --- Dashboard -------------------------------------------------------------
# Dev/preview proxy target for /api, read only by vite.config.ts (Node side).
# The bundle itself makes relative same-origin requests and inlines NO env vars.
VITE_GATEWAY_API_URL=http://localhost:8080

# --- LLM (NOT required for now; enabled in a later milestone) --------------
# GROQ_API_KEY=
