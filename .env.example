# ---------------------------------------------------------------------------
# Copy to `.env` and fill in values. `.env` is git-ignored.
# Nothing in this file is required to complete Milestone 0.
# Real secrets are never committed; in Kubernetes they live in Secrets.
# ---------------------------------------------------------------------------

# --- Gateway ---------------------------------------------------------------
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
# Base URL the gateway uses to reach the WooCommerce MCP server (ClusterIP in k8s)
WOOCOMMERCE_MCP_URL=http://localhost:8081/mcp
# Per-upstream defaults (milliseconds)
UPSTREAM_TIMEOUT_MS=10000
UPSTREAM_CONNECT_TIMEOUT_MS=3000

# --- Application database (PostgreSQL) -------------------------------------
DATABASE_URL=postgresql://mcp:mcp_local_password@localhost:5432/mcp_gateway
POSTGRES_USER=mcp
POSTGRES_PASSWORD=mcp_local_password
POSTGRES_DB=mcp_gateway

# --- WooCommerce REST API (used only by services/woocommerce-mcp) ----------
# Create these in WooCommerce: Settings > Advanced > REST API (read/write).
# Consumer secret is shown only once - never commit the real value.
# WooCommerce only accepts Basic auth (consumer key/secret) when the store is
# served over HTTPS; plain-HTTP stores would need OAuth 1.0a (not implemented).
WOOCOMMERCE_STORE_URL=https://your-store.example
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret
# Optional MCP server settings (defaults shown)
# HOST=127.0.0.1
# PORT=8081
# WOOCOMMERCE_TIMEOUT_MS=10000
# LOG_LEVEL=info
# Comma-separated Host-header allowlist when binding to non-localhost
# MCP_ALLOWED_HOSTS=

# --- Auth ------------------------------------------------------------------
# Pepper added to API-key hashes before storing (keep out of git).
API_KEY_PEPPER=change-me-to-a-long-random-string

# --- Dashboard -------------------------------------------------------------
VITE_GATEWAY_API_URL=http://localhost:8080

# --- LLM (NOT required for now; enabled in a later milestone) --------------
# GROQ_API_KEY=
